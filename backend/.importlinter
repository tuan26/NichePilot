[importlinter]
root_package = nichepilot
include_external_packages = False

# FR-001: phân tầng modular monolith – tầng dưới không được import tầng trên.
[importlinter:contract:layers]
name = Phân tầng: api > jobs > (ai, tools, modules) > core
type = layers
layers =
    nichepilot.api
    nichepilot.jobs
    nichepilot.ai : nichepilot.tools : nichepilot.modules
    nichepilot.core

# FR-025: agent chỉ dùng AI Gateway, Tool Registry và Job Runtime dùng chung – không gọi provider trực tiếp.
[importlinter:contract:agents-no-providers]
name = Agent không import provider AI trực tiếp
type = forbidden
source_modules =
    nichepilot.jobs.agents
forbidden_modules =
    nichepilot.ai.providers
allow_indirect_imports = True

# Module nghiệp vụ độc lập nhau: identity và evidence không phụ thuộc lẫn nhau.
[importlinter:contract:modules-independent]
name = Module identity và evidence độc lập
type = independence
modules =
    nichepilot.modules.identity
    nichepilot.modules.evidence

# E1 (T008): discovery được dùng service công khai của evidence/audit/settings (Constitution VIII),
# nhưng module E0 không được phụ thuộc ngược vào discovery.
[importlinter:contract:e0-modules-not-depend-on-discovery]
name = Module E0 không import module discovery (E1)
type = forbidden
source_modules =
    nichepilot.modules.identity
    nichepilot.modules.evidence
    nichepilot.modules.audit
    nichepilot.modules.settings
forbidden_modules =
    nichepilot.modules.discovery

# E2 (T003): products dùng API công khai chỉ đọc của discovery; discovery và module E0 không phụ thuộc ngược vào products.
[importlinter:contract:no-reverse-dep-on-products]
name = Module E0/E1 không import module products (E2)
type = forbidden
source_modules =
    nichepilot.modules.identity
    nichepilot.modules.evidence
    nichepilot.modules.audit
    nichepilot.modules.settings
    nichepilot.modules.discovery
forbidden_modules =
    nichepilot.modules.products


# E3 (T003): keywords dùng API công khai chỉ đọc của discovery và products; các module đó không phụ thuộc ngược vào keywords.
[importlinter:contract:no-reverse-dep-on-keywords]
name = Module E0/E1/E2 không import module keywords (E3)
type = forbidden
source_modules =
    nichepilot.modules.identity
    nichepilot.modules.evidence
    nichepilot.modules.audit
    nichepilot.modules.settings
    nichepilot.modules.discovery
    nichepilot.modules.products
forbidden_modules =
    nichepilot.modules.keywords

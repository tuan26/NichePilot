# NichePilot – cấu hình mẫu (KHÔNG chứa secret thật).
# Sao chép thành deploy/env/.env rồi điền giá trị. File .env thật KHÔNG được commit.
# Xem specs/001-foundation-ai-infrastructure/contracts/configuration.md

APP_ENV=development
APP_VERSION=0.1.0

# Database (secret)
POSTGRES_USER=nichepilot
POSTGRES_DB=nichepilot
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://nichepilot:change-me-local-only@postgres:5432/nichepilot

# Xác thực
SESSION_IDLE_TIMEOUT_HOURS=12
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
COOKIE_SECURE=false

# AI provider – để trống khi chưa có API key (secret)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Khi phát triển chưa có key: mọi tác vụ dùng MockAIProvider (bị cấm ở production)
AI_PROVIDER_OVERRIDE=mock
# Công tắc gọi API có phí – chỉ đặt true khi chủ sở hữu cho phép
AI_PAID_CALLS_ENABLED=false
MOCK_AI_DEFAULT_SCENARIO=success

# Worker
WORKER_CONCURRENCY=1

# Logging – log ứng dụng giữ tối thiểu 90 ngày
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/var/log/nichepilot
LOG_RETENTION_DAYS=90
LOG_DISK_WARN_GB=2

# Backup
BACKUP_RETENTION=7
BACKUP_CRON=0 3 * * *
# Múi giờ của BACKUP_CRON (mặc định Asia/Ho_Chi_Minh)
BACKUP_TZ=Asia/Ho_Chi_Minh

# E1 – SearXNG (secret): sinh giá trị ngẫu nhiên khi cài, ví dụ `openssl rand -hex 32`. KHÔNG commit giá trị thật.
SEARXNG_SECRET=
SEARXNG_URL=http://searxng:8080
# E1 – PII engine (quyết định I2): production chỉ chấp nhận engine trong danh sách phê duyệt
PII_ENGINE=regex-phone
PII_APPROVED_ENGINES=regex-phone
# E1 – nguồn dữ liệu: real (mặc định) | mock (CHỈ development/test – production từ chối khởi động)
DISCOVERY_SOURCE_MODE=real
# E1 – profile tùy chọn browser-fetcher (TẮT mặc định): PAGE_FETCHER=browser + BROWSER_WS_ENDPOINT=ws://browser-fetcher:3000/
PAGE_FETCHER=http

# Bộ test live (chỉ chạy thủ công khi được cho phép)
NICHEPILOT_LIVE_MAX_USD=0.05
